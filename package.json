{
    "name": "nostr-how",
    "version": "0.2.0",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": "24.x"
    },
    "packageManager": "bun@1.4.4",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "node ./scripts/check-locales.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "check:locales": "node ./scripts/check-locales.mjs",
        "check:production": "node ./scripts/check-production.mjs",
        "lint-check": "biome lint",
        "lint-write": "biome lint --write",
        "format-check": "biome format",
        "format-write": "biome format --write",
        "audit": "bun audit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@sveltejs/kit": "^3.1.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "mdsvex": "^0.12.8",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    },
    "type": "module",
    "dependencies": {
        "@sveltejs/adapter-vercel": "^7.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "rehype-external-links": "^3.0.0",
        "svelte-i18n": "^4.0.1",
        "unist-util-visit": "^5.1.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "overrides": {
        "esbuild": "^0.28.2",
        "postcss-selector-parser": "^7.1.7"
    }
}
